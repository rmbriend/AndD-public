    "# leer primer imagen\n",
    "def read_image_gray(image_name):\n",
    "   # image_path = os.path.join(\"white_patch\", image_name)\n",
    "    img = cv.imread(image_name, cv.IMREAD_GRAYSCALE)\n",
    "    if img is None:\n",
    "            print(\"Image not found.\")\n",
    "    return(img)    "
   ]
  },
  {
   "cell_type": "code",
